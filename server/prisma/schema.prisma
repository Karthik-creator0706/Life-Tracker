generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  passwordHash String
  calorieGoal  Int? // daily calorie target (kcal); null = not set
  studyGoalMin Int? // daily study target (minutes); null = not set
  screenLimitMin Int? // daily screen-time limit (minutes); null = not set
  phone        String? // optional contact number shown on the profile
  avatar       String? // "preset:<name>" or an uploaded picture as a small data: URL; null = initials
  createdAt    DateTime @default(now())

  todos        Todo[]
  transactions Transaction[]
  workouts     Workout[]
  runs         Run[]
  bodyMetrics  BodyMetric[]
  challenges   Challenge[]
  diaryEntries DiaryEntry[]
  foodEntries  FoodEntry[]
  books        Book[]
  studySessions StudySession[]
  careerTasks  CareerTask[]
  characterTraits      CharacterTrait[]
  characterLogs        CharacterLog[]
  characterReflections CharacterReflection[]
  templeVisits         TempleVisit[]
  screenTimes          ScreenTime[]
  movies               Movie[]
}

// ---------- Screen time: minutes per app per day (one row per app per day) ----------
model ScreenTime {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime // a calendar day, stored as UTC midnight
  app       String // INSTAGRAM | YOUTUBE | GAMES | MOVIES | OTHER
  minutes   Int
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, date, app])
  @@index([userId, date])
}

// ---------- Movies & series: what you watched, are watching, want to watch, loved and hated ----------
model Movie {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title     String
  kind      String    @default("MOVIE") // MOVIE | SERIES
  status    String // WATCHING | WATCHED | WANT
  reaction  String? // LOVED | OKAY | HATED
  favorite  Boolean   @default(false)
  rating    Int? // 1-5, once watched
  platform  String? // Netflix, theatre, YouTube...
  review    String? // what you thought
  watchedOn DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([userId, status])
}

// ---------- Temple: every day you went, and to which temple ----------
model TempleVisit {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime // the day you went (a calendar day, stored as UTC midnight)
  temple    String // which temple, e.g. "Murugan temple"
  note      String? // a prayer, a wish, how it felt
  createdAt DateTime @default(now())

  @@unique([userId, date, temple])
  @@index([userId, date])
}

// ---------- Character: the good qualities you are growing, one check-in per quality per day ----------
model CharacterTrait {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name      String // e.g. "Patience"
  emoji     String         @default("⭐")
  why       String? // why it matters to you / what it looks like
  createdAt DateTime       @default(now())
  logs      CharacterLog[]

  @@index([userId])
}

model CharacterLog {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  traitId   Int
  trait     CharacterTrait @relation(fields: [traitId], references: [id], onDelete: Cascade)
  date      DateTime // the day you practised it
  note      String? // what you actually did
  createdAt DateTime       @default(now())

  @@unique([traitId, date])
  @@index([userId, date])
}

model CharacterReflection {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime
  wins      String? // the good things you did today
  improve   String? // one thing to do better tomorrow
  rating    Int? // 1-5: how did you live up to your best self today
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, date])
}

// ---------- Career: what you studied, and what you need to get done ----------
model StudySession {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime
  topic     String // what you covered, e.g. "React hooks"
  subject   String? // the bigger area, e.g. "Frontend"
  minutes   Int
  notes     String? // what you learned
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, date])
}

model CareerTask {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title     String
  subject   String?
  dueDate   DateTime // the day it should be finished by (today, end of this week, end of this month, or any date)
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, done, dueDate])
}

// ---------- Books (reading list, progress, and the moral you took from each) ----------
model Book {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title       String
  author      String?
  status      String // READING | FINISHED | WANT
  totalPages  Int?
  currentPage Int?
  rating      Int? // 1-5, when finished
  moral       String?   // the lesson / moral you got from it
  startedOn   DateTime?
  finishedOn  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([userId, status])
}

// ---------- Food log (what you ate, when, and where) ----------
model FoodEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime
  meal      String // BREAKFAST | LUNCH | DINNER | SNACK
  place     String // HOME | OUTSIDE
  name      String
  calories  Int? // kcal, optional
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ---------- Diary (one entry per day) ----------
model DiaryEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime
  title     String?
  content   String  
  mood      String? // GREAT | GOOD | OKAY | LOW | BAD
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, date])
}

// ---------- To-do ----------
model Todo {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  priority  String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  done      Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  @@index([userId])
}

// ---------- Money ----------
model Transaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type      String // INCOME | EXPENSE
  amount    Decimal  @db.Decimal(12, 2)
  category  String
  note      String?
  date      DateTime
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ---------- Body / Fitness ----------
model Workout {
  id          Int               @id @default(autoincrement())
  userId      Int
  user        User              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date        DateTime
  title       String // e.g. "Push day"
  durationMin Int?
  notes       String?
  exercises   WorkoutExercise[]
  createdAt   DateTime          @default(now())

  @@index([userId, date])
}

model WorkoutExercise {
  id        Int     @id @default(autoincrement())
  workoutId Int
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  sets      Int
  reps      Int
  weightKg  Float?
}

model Run {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date        DateTime
  rounds      Float
  durationMin Float
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model BodyMetric {
  id       Int      @id @default(autoincrement())
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date     DateTime
  weightKg Float
  notes    String?

  @@index([userId, date])
}

// ---------- Challenges ----------
model Challenge {
  id          Int                @id @default(autoincrement())
  userId      Int
  user        User               @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title       String
  description String?
  startDate   DateTime
  targetDays  Int
  checkins    ChallengeCheckin[]
  createdAt   DateTime           @default(now())

  @@index([userId])
}

model ChallengeCheckin {
  id          Int       @id @default(autoincrement())
  challengeId Int
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  date        DateTime

  @@unique([challengeId, date])
}
