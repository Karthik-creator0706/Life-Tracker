# PostgreSQL. The database ("lifetracker") is created for you by `npm run db:push`.
# If the password has special characters, URL-encode them (for example # becomes %23, @ becomes %40).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5000/lifetracker?schema=public"

PORT=4000

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="change-me"
# Registration is open only while no users exist. Set true to let more people sign up.
ALLOW_SIGNUP=false
